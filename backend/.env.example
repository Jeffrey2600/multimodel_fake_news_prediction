# ---- Required --------------------------------------------------------------
# Google Gemini API key — create one at https://aistudio.google.com/apikey
# You can list several keys separated by commas (from different Google projects);
# when one runs out of free daily quota the next one is used automatically.
GEMINI_API_KEY=

# ---- Optional --------------------------------------------------------------
# NewsAPI key (https://newsapi.org) — adds recent news articles as evidence
NEWSAPI_KEY=

# Port the app runs on (used by run.bat / run.sh)
PORT=8000

# Secret used to sign login sessions. Leave empty to auto-generate one on first run.
JWT_SECRET=

# Max upload size in MB, and checks allowed per minute per user
MAX_UPLOAD_MB=40
RATE_LIMIT_PER_MIN=12

# Advanced: Gemini models to try, in order (comma separated). Leave empty for defaults.
# GEMINI_MODELS=
# GEMINI_LIGHT_MODELS=
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Offline fallback models (downloaded automatically on first use)
# WHISPER_MODEL=base
# NLI_MODEL=Xenova/nli-deberta-v3-xsmall
